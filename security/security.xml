<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meeting" model="ir.module.category">
        <field name="name">Meetings</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_meeting_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_meeting"/>
        <field name="comment">Sees the meetings of the channels they belong to, deletes their own recordings.</field>
    </record>

    <record id="group_meeting_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_meeting"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sees and deletes every meeting, sets up AI.</field>
    </record>

    <!-- Every internal user can record and see the meetings of their channels -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_meeting_user'))]"/>
    </record>

    <!-- Meetings of the channels the user is a member of -->
    <record id="rule_meeting_member" model="ir.rule">
        <field name="name">Meetings: channel members</field>
        <field name="model_id" ref="model_isd_meeting"/>
        <field name="domain_force">[('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
    </record>
    <record id="rule_meeting_manager" model="ir.rule">
        <field name="name">Meetings: all</field>
        <field name="model_id" ref="model_isd_meeting"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
    </record>

    <record id="rule_attendee_member" model="ir.rule">
        <field name="name">Meeting attendees: channel members</field>
        <field name="model_id" ref="model_isd_meeting_attendee"/>
        <field name="domain_force">[('meeting_id.channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
    </record>
    <record id="rule_attendee_manager" model="ir.rule">
        <field name="name">Meeting attendees: all</field>
        <field name="model_id" ref="model_isd_meeting_attendee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
    </record>

    <!-- Recordings: read like the meeting, delete only one's own -->
    <record id="rule_recording_member_read" model="ir.rule">
        <field name="name">Recordings: channel members read</field>
        <field name="model_id" ref="model_isd_meeting_recording"/>
        <field name="domain_force">[('meeting_id.channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_recording_own" model="ir.rule">
        <field name="name">Recordings: own ones</field>
        <field name="model_id" ref="model_isd_meeting_recording"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_recording_manager" model="ir.rule">
        <field name="name">Recordings: all</field>
        <field name="model_id" ref="model_isd_meeting_recording"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
    </record>

    <record id="rule_ai_run_member" model="ir.rule">
        <field name="name">AI runs: channel members</field>
        <field name="model_id" ref="model_isd_meeting_ai_run"/>
        <field name="domain_force">[('meeting_id.channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
    </record>
    <record id="rule_ai_run_manager" model="ir.rule">
        <field name="name">AI runs: all</field>
        <field name="model_id" ref="model_isd_meeting_ai_run"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
    </record>

    <record id="rule_ai_config_company" model="ir.rule">
        <field name="name">Meeting AI settings: own companies</field>
        <field name="model_id" ref="model_isd_meeting_ai_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Call backgrounds: company ones for everyone of the company, personal ones for their owner -->
    <record id="rule_background_read" model="ir.rule">
        <field name="name">Call backgrounds: company and own</field>
        <field name="model_id" ref="model_isd_meeting_background"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), '&amp;', ('scope', '=', 'company'), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_background_own" model="ir.rule">
        <field name="name">Call backgrounds: own personal ones</field>
        <field name="model_id" ref="model_isd_meeting_background"/>
        <field name="domain_force">[('scope', '=', 'personal'), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_background_manager" model="ir.rule">
        <field name="name">Call backgrounds: company ones and own ones (managers)</field>
        <field name="model_id" ref="model_isd_meeting_background"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), '&amp;', ('scope', '=', 'company'), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
    </record>
</odoo>
