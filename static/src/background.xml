<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="isd_meeting.BackgroundDialog">
        <Dialog title.translate="Virtual background" size="'lg'" footer="false">
            <p t-if="!cameraOn" class="alert alert-info py-2 small">Your camera is off. The background will be used when you turn it on.</p>

            <div class="o_isd_meeting_bg_grid mb-3">
                <button type="button" title="None" t-att-disabled="state.busy" t-on-click="() => this.bg.choose('none')"
                        t-att-class="tileClass(isChosen('none'))">
                    <span class="o_isd_meeting_bg_icon"><i class="fa fa-ban fa-2x"/></span>
                    <span class="o_isd_meeting_bg_label">None</span>
                </button>
                <button type="button" title="Blur" t-att-disabled="state.busy" t-on-click="() => this.bg.choose('blur')"
                        t-att-class="tileClass(isChosen('blur'))">
                    <span class="o_isd_meeting_bg_icon o_isd_meeting_bg_blur"><i class="fa fa-user fa-2x"/></span>
                    <span class="o_isd_meeting_bg_label">Blur</span>
                </button>
            </div>

            <h6 class="fw-bold">Company backgrounds</h6>
            <div t-if="!bg.companyBackgrounds.length" class="text-muted small mb-3">
                None yet.<t t-if="state.isManager"> Tick "Share with the whole company" below and add a picture.</t>
            </div>
            <div t-else="" class="o_isd_meeting_bg_grid mb-3">
                <button t-foreach="bg.companyBackgrounds" t-as="item" t-key="item.id" type="button"
                        t-att-title="item.name" t-att-disabled="state.busy" t-on-click="() => this.bg.choose('image', item.id)"
                        t-att-class="tileClass(isChosen('image', item))">
                    <img t-att-src="item.thumb" alt="" class="o_isd_meeting_bg_img"/>
                    <span class="o_isd_meeting_bg_label" t-esc="item.name"/>
                    <span t-if="item.can_delete" class="o_isd_meeting_bg_delete" title="Delete" t-on-click.stop="() => this.bg.remove(item)"><i class="fa fa-trash"/></span>
                </button>
            </div>

            <h6 class="fw-bold">My backgrounds</h6>
            <div class="o_isd_meeting_bg_grid mb-2">
                <button t-foreach="bg.myBackgrounds" t-as="item" t-key="item.id" type="button"
                        t-att-title="item.name" t-att-disabled="state.busy" t-on-click="() => this.bg.choose('image', item.id)"
                        t-att-class="tileClass(isChosen('image', item))">
                    <img t-att-src="item.thumb" alt="" class="o_isd_meeting_bg_img"/>
                    <span class="o_isd_meeting_bg_label" t-esc="item.name"/>
                    <span class="o_isd_meeting_bg_delete" title="Delete" t-on-click.stop="() => this.bg.remove(item)"><i class="fa fa-trash"/></span>
                </button>
                <label t-att-class="'o_isd_meeting_bg_tile o_isd_meeting_bg_add btn btn-outline-secondary p-0 position-relative' + (state.busy ? ' disabled' : '')">
                    <input type="file" accept="image/jpeg,image/png,image/webp" class="d-none" t-on-change="onFile" t-att-disabled="state.busy"/>
                    <span class="o_isd_meeting_bg_icon"><i t-att-class="'fa fa-2x ' + (state.busy ? 'fa-spinner fa-spin' : 'fa-plus')"/></span>
                    <span class="o_isd_meeting_bg_label">Add a picture</span>
                </label>
            </div>
            <div t-if="state.isManager" class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="isd_bg_share" t-model="local.share"/>
                <label class="form-check-label" for="isd_bg_share">Share with the whole company (the next picture I add becomes a company background)</label>
            </div>
            <p class="small text-muted mb-0">A wide picture (16:9) looks best. Edges of hair and hands can look soft; a well-lit room helps.</p>
        </Dialog>
    </t>

</templates>
