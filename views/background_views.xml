<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_background_kanban" model="ir.ui.view">
        <field name="name">isd.meeting.background.kanban</field>
        <field name="model">isd.meeting.background</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <field name="image_512" widget="image" class="o_isd_meeting_bg_card" options="{'img_class': 'w-100 object-fit-cover'}"/>
                        <div class="p-2">
                            <field name="name" class="fw-bold"/>
                            <div class="small text-muted">
                                <field name="scope"/>
                                <t t-if="record.user_id.raw_value"> · <field name="user_id"/></t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_background_list" model="ir.ui.view">
        <field name="name">isd.meeting.background.list</field>
        <field name="model">isd.meeting.background</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [64, 36]}" string="Picture"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_background_form" model="ir.ui.view">
        <field name="name">isd.meeting.background.form</field>
        <field name="model">isd.meeting.background</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="o_isd_meeting_bg_preview" options="{'preview_image': 'image_512'}"/>
                    <group>
                        <field name="name"/>
                        <field name="scope" widget="radio" options="{'horizontal': true}"/>
                        <field name="user_id" invisible="scope != 'personal'" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <div class="text-muted small">
                        Company backgrounds are offered to everyone of the company in the call's
                        "Virtual background" menu. Personal backgrounds are seen only by their owner.
                        A wide picture (16:9, at least 1280×720) looks best.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_background_search" model="ir.ui.view">
        <field name="name">isd.meeting.background.search</field>
        <field name="model">isd.meeting.background</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="company" string="Company" domain="[('scope', '=', 'company')]"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_background" model="ir.actions.act_window">
        <field name="name">Call Backgrounds</field>
        <field name="res_model">isd.meeting.background</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_scope': 'company'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a background picture</p>
            <p>People pick it in a call from the "Virtual background" menu.</p>
        </field>
    </record>
</odoo>
